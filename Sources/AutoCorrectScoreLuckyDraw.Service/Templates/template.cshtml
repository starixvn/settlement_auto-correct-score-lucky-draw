<div>- Match: @Model.Match.TeamName</div>
<div>- MatchID: @Model.Match.MatchId</div>
<div>- KO Time (GMT +8): @Model.Match.KickOffTime.ToString("MM/dd/yyyy hh:mm tt")</div>
<div>- Lucky Draw Date: @Model.Match.CreatedDate.ToString("MM/dd/yyyy")</div>
<div>- List of winning members:</div>
<br />
<table>
    <tr style="background-color:#0095CC">
        <th style="width:60px">No.</th>
        <th style="width:150px">Member</th>
        <th style="width:150px">Site</th>
        <th style="width:150px">Amount</th>
        <th style="width:200px">Currency</th>
    </tr>
    @{
        var i = 1;
    }
    @foreach (var item in Model.Tickets)
    {
        <tr>
            <td>@i</td>
            <td>@item.Username</td>
            <td>@item.Site</td>
            <td>@item.PrizeAmount.ToString("#,0")</td>
            <td>@item.CurrencyName</td>
        </tr>
        i++;
    }
</table>

<style>
    body {
        font-family: tahoma;
        font-size: 12px;
    }

    table {
        border-collapse: collapse;
    }

    table, td, th {
        border: 1px solid black;
        text-align: center;
    }

    th {
        padding: 4px;
        color: white;
        font-family: tahoma;
        font-size: 12px;
    }

    td {
        padding: 4px;
        font-family: tahoma;
        font-size: 12px;
    }
</style>